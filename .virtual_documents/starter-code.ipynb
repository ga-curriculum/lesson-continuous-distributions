# Define X, Y, Z here:
























X = stats.expon(scale=7)
Y = stats.expon(scale=15)

n = 100_000
xs = X.rvs(n)
ys = Y.rvs(n)

# Smoothed out histogram = "density plot" or "KDE plot"
# sns.densityplot()
plt.figure(figsize=(8, 5))
sns.kdeplot(xs, fill=True)
